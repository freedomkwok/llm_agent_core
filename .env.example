OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=openai/gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

ZEP_CLIENT_BACKEND=zep_cloud
ZEP_API_KEY=your_zep_api_key
GRAPH_ID=your_graph_id

# To use the local Graphiti OraclePG backend instead of Zep Cloud:
# ZEP_CLIENT_BACKEND=OraclePG
# ORACLEPG_DSN=localhost:1521/FREEPDB1
# ORACLEPG_USER=graphiti
# ORACLEPG_PASSWORD=graphiti
# ORACLEPG_GRAPH_ID=your_graph_id
