{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Skill Router: Local Flow Debug",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/agents/skill_route_agent/run_local.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/agents/skill_route_agent",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/agents/skill_route_agent/.env",
      "justMyCode": false
    },


    {
      "name": "A2A Example: 05 Test Local Calls",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/examples/a2a/05_test_local_calls.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
