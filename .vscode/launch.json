{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Zep Agent: run_local (A2A debug)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/imp_agent_core/agents/zep_agent/run_local.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/imp_agent_core/agents/zep_agent",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/imp_agent_core/agents/zep_agent/.env",
      "justMyCode": false
    },
    {
      "name": "A2A Example: 05 Test Local Calls",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/examples/a2a/05_test_local_calls.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Zep Agent: test_zep_agent_connectivity",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/imp_agent_core/agents/zep_agent/tests/test_zep_agent_connectivity.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/imp_agent_core/agents/zep_agent/.env",
      "justMyCode": false
    }
  ]
}
